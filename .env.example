# Copy this file to .env and fill in your key. .env is git-ignored.
OPENAI_API_KEY=

# Which model each "role" uses, as "provider:model".
# Swap provider later (e.g. anthropic:..., ollama:...) without code changes.
MODEL_FAST=openai:gpt-6-luna
MODEL_SMART=openai:gpt-6.1-sol

# Optional for public repos (lifts GitHub's rate limit from 60 to 5000 requests/hour).
# Required for private repos. A fine-grained token with read-only "Pull requests" + "Contents" is enough.
GITHUB_TOKEN=

# Where the Next.js UI runs (Step 11). The API only lets these origins call it.
FRONTEND_ORIGINS=http://localhost:3000
