# Copy this file to .env and fill in your key. .env is git-ignored.
OPENAI_API_KEY=

# Which model each "role" uses, as "provider:model".
# Swap provider later (e.g. anthropic:..., ollama:...) without code changes.
MODEL_FAST=openai:gpt-6-luna
MODEL_SMART=openai:gpt-6.1-sol

# Optional for public repos (lifts GitHub's rate limit from 60 to 5000 requests/hour).
# Required for private repos. A fine-grained token with read-only "Pull requests" + "Contents" is enough.
GITHUB_TOKEN=

# Where the Next.js UI runs (Step 11). The API only lets these origins call it.
FRONTEND_ORIGINS=http://localhost:3000

# Postgres from docker-compose.yml (Step 12). "+psycopg" picks the driver SQLAlchemy uses.
DATABASE_URL=postgresql+psycopg://pr_review:pr_review@localhost:5432/pr_review

# Redis from docker-compose.yml (Step 13): the review queue and live-event pub/sub.
REDIS_URL=redis://localhost:6380

# GitHub webhooks (Step 14b). The same random string you type into the GitHub App's
# "Webhook secret" field. Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
# Empty = POST /webhooks/github refuses everything (503).
GITHUB_WEBHOOK_SECRET="3ebd7457fbd387e84db7c21c5c0f6fe604a6c177c6313c66ac7ef699df9d30f9"

# GitHub App (Step 14c): reviews are posted to the PR as the App. Both empty = never post.
# App ID: the number at the top of the App's General page.
# Private key: General -> Private keys -> Generate. Keep the .pem outside the repo, chmod 600.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
